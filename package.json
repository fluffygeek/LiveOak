{
  "name": "liveoak",
  "private": true,
  "version": "0.1.0",
  "description": "LiveOak payroll job tracking platform",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* --filter=./apps/* run build",
    "dev:api": "pnpm --filter @liveoak/api dev",
    "dev:worker": "pnpm --filter @liveoak/worker dev",
    "dev:admin-web": "pnpm --filter @liveoak/admin-web dev",
    "dev:mobile": "pnpm --filter @liveoak/mobile start",
    "db:generate": "pnpm --filter @liveoak/db generate",
    "db:migrate": "pnpm --filter @liveoak/db migrate",
    "db:seed-admin": "pnpm --filter @liveoak/db seed:admin",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  }
}
