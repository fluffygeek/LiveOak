# --- Database ---
DATABASE_URL=postgres://liveoak:liveoak@localhost:5432/liveoak

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Object storage (S3-compatible) ---
S3_BUCKET=liveoak-job-photos
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# --- Google OAuth (Workspace-restricted) ---
GOOGLE_OAUTH_CLIENT_ID_WEB=
GOOGLE_OAUTH_CLIENT_ID_IOS=
GOOGLE_OAUTH_CLIENT_ID_ANDROID=
GOOGLE_WORKSPACE_DOMAIN=example.com

# --- Admin web (apps/admin-web) ---
# Same value as GOOGLE_OAUTH_CLIENT_ID_WEB above, exposed to the browser for
# Google Identity Services' initialize() call.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID_WEB=
NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-side (route handler) base URL for reaching the API; same as
# NEXT_PUBLIC_API_URL in most setups but kept separate for container networking.
API_URL=http://localhost:4000

# --- JWT ---
# Each must be at least 32 random characters, e.g. `openssl rand -base64 32`.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- USPS APIs v3 ---
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=

# --- Email (Postmark) ---
POSTMARK_SERVER_TOKEN=
DIGEST_EMAIL_FROM=alerts@example.com

# --- Mobile (apps/mobile) ---
# Expo inlines EXPO_PUBLIC_-prefixed vars into the client bundle at build time.
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID_WEB=
# Only required for iOS builds (GoogleSignin.configure's iosClientId).
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID_IOS=

# --- App ---
NODE_ENV=development
API_PORT=4000
# Comma-separated list of origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000

# --- Error monitoring (apps/api, apps/worker) ---
# Optional — errors are just logged (not reported anywhere) if unset.
SENTRY_DSN=
