# --- Database ---
DATABASE_URL=postgres://liveoak:liveoak@localhost:5432/liveoak

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Object storage (S3-compatible) ---
S3_BUCKET=liveoak-job-photos
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# --- Google OAuth (Workspace-restricted) ---
GOOGLE_OAUTH_CLIENT_ID_WEB=
GOOGLE_OAUTH_CLIENT_ID_IOS=
GOOGLE_OAUTH_CLIENT_ID_ANDROID=
GOOGLE_WORKSPACE_DOMAIN=example.com

# --- JWT ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- USPS APIs v3 ---
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=

# --- Email (Postmark) ---
POSTMARK_SERVER_TOKEN=
DIGEST_EMAIL_FROM=alerts@example.com

# --- App ---
NODE_ENV=development
API_PORT=4000
